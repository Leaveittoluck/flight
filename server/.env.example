# All variables below are required at startup.
# Copy this file to .env and fill in the values.

PORT=5000
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
# Production: use the URL from your host (e.g. Render) — SSL is added automatically when NODE_ENV=production
DB_SCHEMA=flight
NODE_ENV=development
# Production: set to production
PEXELS_API_KEY=your_pexels_api_key_here

# Google OAuth — create credentials at console.cloud.google.com
# Local authorised redirect URI:   http://localhost:5000/api/auth/google/callback
# Production authorised redirect URI: https://your-api.onrender.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
# Production: GOOGLE_CALLBACK_URL=https://your-api.onrender.com/api/auth/google/callback

# Session — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Frontend origin (used for CORS and post-auth redirects)
CLIENT_ORIGIN=http://localhost:5173
# Production: CLIENT_ORIGIN=https://your-app.vercel.app
